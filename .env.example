# Copy to .env before you start:   make env
#
# .env is gitignored. This file is the committed, credential-free template.
# The pattern matters: config lives in the environment (12-factor), secrets never
# live in git, and a new engineer can see every knob that exists in one place.
#
# Every value below is read by internal/config. If you add a variable there, add it
# here too, or the next person will not know it exists.

# --- Runtime -----------------------------------------------------------------
# development -> human-readable text logs. production -> JSON logs for shipping.
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=debug

# --- API server --------------------------------------------------------------
API_HTTP_ADDR=:8080
API_READ_TIMEOUT=10s
API_WRITE_TIMEOUT=15s
API_IDLE_TIMEOUT=60s
# How long in-flight requests get to finish after SIGTERM before we force-close.
# Must stay comfortably under the pod's terminationGracePeriodSeconds (default 30s).
API_SHUTDOWN_TIMEOUT=15s

# --- PostgreSQL --------------------------------------------------------------
# Port 55432, NOT 5432: your Homebrew Postgres owns 5432 and we must not collide
# with it. This database runs in a disposable container (make db-up).
POSTGRES_USER=kca
POSTGRES_PASSWORD=kca_local_dev_only
POSTGRES_DB=kca_dev
POSTGRES_HOST_PORT=55432
DATABASE_URL=postgres://kca:kca_local_dev_only@localhost:55432/kca_dev?sslmode=disable
DB_MAX_OPEN_CONNS=20
# A FLOOR of warm connections, not a ceiling (pgx semantics; see internal/config).
DB_MIN_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# --- Prometheus --------------------------------------------------------------
# Reachable from the host via the kind extraPortMapping (see deploy/kind/cluster.yaml).
# When we later run in-cluster, this becomes the in-cluster Service DNS name.
PROMETHEUS_URL=http://localhost:19090
PROMETHEUS_TIMEOUT=30s

# --- Collector (Phase 4) -----------------------------------------------------
COLLECTOR_INTERVAL=5m
COLLECTOR_WORKERS=4
