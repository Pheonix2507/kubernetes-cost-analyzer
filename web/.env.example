# Copy to .env.local. NOTE THE ABSENT NEXT_PUBLIC_ PREFIX ON EVERY VARIABLE HERE.
#
# Next.js inlines only NEXT_PUBLIC_* into the CLIENT bundle. A plain name is readable on the server and
# simply `undefined` in the browser, which is the entire mechanism keeping the API key out of a
# visitor's Network tab. One misplaced prefix would ship the credential to everyone.

# Where the Go API lives, from the Next.js SERVER's point of view.
KCA_API_URL=http://localhost:8080

# This app's own origin. Server Components have no ambient origin to resolve a relative fetch against
# -- the browser does, Node does not -- so an absolute URL is required for the server-side path.
KCA_SELF_URL=http://localhost:3000

# The API key, if the API requires one. Leave EMPTY in development: config.Validate permits an
# unauthenticated API outside production, so `make run-api` and this dashboard both work with no
# ceremony. If the API does require a key and none is set here, the API answers 401 and that status is
# forwarded unchanged -- a more useful error than anything the proxy could invent.
KCA_API_KEY=
